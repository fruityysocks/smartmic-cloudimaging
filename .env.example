# AWS Configuration
AWS_REGION=us-east-1

# AWS HealthImaging Configuration
AWS_HEALTHIMAGING_DATASTORE_ID=your-datastore-id
AWS_HEALTHIMAGING_DATASTORE_NAME=your-datastore-name
AWS_HEALTHIMAGING_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/HealthImagingServiceRole

# S3 Buckets (only 2 required)
# Source bucket: Where your DICOM files are stored
AWS_S3_SOURCE_BUCKET=your-source-bucket
AWS_S3_SOURCE_PREFIX=path-inside-bucket

# Output bucket: Where AWS HealthImaging writes import job logs
AWS_S3_OUTPUT_BUCKET=your-output-bucket
AWS_S3_OUTPUT_PREFIX=path-inside-bucket

# Optional: API Server Configuration
PORT=8080
