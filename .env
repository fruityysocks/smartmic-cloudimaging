# AWS Configuration
AWS_REGION=us-east-1

# AWS HealthImaging
AWS_HEALTHIMAGING_DATASTORE_ID=12e041ae34334ab28c16ab92cde81e2c
AWS_HEALTHIMAGING_DATASTORE_NAME=single-file-datastore
AWS_HEALTHIMAGING_ROLE_ARN=arn:aws:iam::207799300633:role/HealthImagingServiceRole

# S3 Buckets (only 2 required)
AWS_S3_SOURCE_BUCKET=target-healthimaging-test
AWS_S3_OUTPUT_BUCKET=output-healthimaging-test

#prefixes
AWS_S3_SOURCE_PREFIX=case13fr
AWS_S3_OUTPUT_PREFIX=dicom-files

# Optional
PORT1=8080
PORT2=9090